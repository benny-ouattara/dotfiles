[global]
    font = Iosevka Term 12
    origin = top-right
    offset = (10, 10)
    width = 300
    height = (0, 100)
    padding = 12
    horizontal_padding = 12
    frame_width = 2
    frame_color = "#89B4FA"
    separator_color = frame
    corner_radius = 8
    icon_position = left
    max_icon_size = 48
    transparency = 0
    format = "<b>%s</b>\n%b"

[urgency_low]
    background = "#1E1E2E"
    foreground = "#CDD6F4"
    frame_color = "#89B4FA"
    timeout = 5

[urgency_normal]
    background = "#1E1E2E"
    foreground = "#CDD6F4"
    frame_color = "#89B4FA"
    timeout = 10

[urgency_critical]
    background = "#1E1E2E"
    foreground = "#CDD6F4"
    frame_color = "#F38BA8"
    timeout = 0
