{
    verbs: [
        // Open in emacs at specific line
        {
            invocation: edit
            shortcut: e
            key: enter
            apply_to: text_file
            execution: "emacsclient -n +{line} {file}"
            leave_broot: false
        }

        // Create new file
        {
            invocation: create {subpath}
            execution: "emacsclient -n {directory}/{subpath}"
            leave_broot: false
        }

        // Git diff
        {
            invocation: git_diff
            shortcut: gd
            leave_broot: false
            execution: "git difftool -y {file}"
        }

        // Toggle git status filter
        {
            key: alt-g
            execution: ":toggle_git_status"
        }

        // Jump to git root
        {
            invocation: gtr
            execution: ":focus {git-root}"
        }

        // Open terminal at current directory
        {
            invocation: terminal
            key: ctrl-t
            execution: "$SHELL"
            set_working_dir: true
            leave_broot: false
        }

        // Move to trash instead of permanent delete
        {
            invocation: rm
            internal: trash
            leave_broot: false
        }

        // Copy file to other panel
        {
            key: F5
            external: "cp -r {file} {other-panel-directory}"
            leave_broot: false
        }

        // Move file to other panel
        {
            key: F6
            external: "mv {file} {other-panel-directory}"
            leave_broot: false
        }
    ]
}
