#!/usr/bin/env bash
# Screen recording with ffmpeg, after Omarchy's omarchy-capture-screenrecording.
# Running it while a recording is in progress stops that recording instead.
# Usage: record region|screen [none|desktop|mic|both]   start or stop a recording
#        record stop                                    stop and save
#        record status                                  succeed while recording
#        record indicator                               polybar recording module
#
# Recordings go to ~/Videos/screenrecording-YYYY-MM-DD_HH-MM-SS.mp4. Omarchy's
# gpu-screen-recorder can't load EGL on this system, so this uses x11grab with
# VAAPI H.264 (libx264 without a render node) and AAC audio.

DIR="${XDG_VIDEOS_DIR:-$HOME/Videos}"
STATE="${XDG_RUNTIME_DIR:-/tmp}/record"
PID_FILE="$STATE.pid"
OUT_FILE="$STATE.file"
LOG_FILE="$STATE.log"
RENDER_NODE=/dev/dri/renderD128

recording() {
    [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

refresh_bar() {
    polybar-msg action recording hook 0 >/dev/null 2>&1
}

fail() {
    notify-send -u critical "Screen recording" "$1"
    echo "record: $1" >&2
    exit 1
}

mic_source() {
    # The default source, unless that is a sink monitor (then the first real input)
    local source
    source=$(pactl get-default-source)
    if [[ "$source" == *.monitor ]]; then
        source=$(pactl list short sources | awk '$2 !~ /\.monitor$/ { print $2; exit }')
    fi
    echo "$source"
}

start() {
    local target="$1" audio="$2" geometry w h x y file monitor
    local args=() audio_args=() video_args=()

    command -v ffmpeg >/dev/null || fail "ffmpeg is not installed (run guix home reconfigure)"
    if [[ "$target" == region ]]; then
        command -v slop >/dev/null || fail "slop is not installed (run guix home reconfigure)"
        # Escape in slop cancels
        geometry=$(slop -f '%w %h %x %y') || exit 0
    else
        geometry="$(xdotool getdisplaygeometry) 0 0"
    fi
    read -r w h x y <<< "$geometry"
    # H.264 needs even dimensions
    w=$((w / 2 * 2))
    h=$((h / 2 * 2))
    ((w > 0 && h > 0)) || exit 0

    args=(-thread_queue_size 512 -f x11grab -framerate 60 -draw_mouse 1
          -video_size "${w}x${h}" -i "${DISPLAY:-:0}+$x,$y")
    monitor="$(pactl get-default-sink).monitor"
    case "$audio" in
        none) ;;
        desktop)
            args+=(-thread_queue_size 512 -f pulse -i "$monitor")
            audio_args=(-c:a aac -b:a 160k)
            ;;
        mic)
            args+=(-thread_queue_size 512 -f pulse -i "$(mic_source)")
            audio_args=(-c:a aac -b:a 160k)
            ;;
        both)
            args+=(-thread_queue_size 512 -f pulse -i "$monitor"
                   -thread_queue_size 512 -f pulse -i "$(mic_source)")
            audio_args=(-filter_complex "[1:a][2:a]amix=inputs=2:duration=first[a]"
                        -map 0:v -map "[a]" -c:a aac -b:a 160k)
            ;;
        *) fail "Unknown audio option: $audio" ;;
    esac

    if [[ -e "$RENDER_NODE" ]]; then
        video_args=(-vaapi_device "$RENDER_NODE" -vf "format=nv12,hwupload" -c:v h264_vaapi -qp 24)
    else
        video_args=(-c:v libx264 -preset veryfast -crf 23 -pix_fmt yuv420p)
    fi

    mkdir -p "$DIR"
    file="$DIR/screenrecording-$(date +%Y-%m-%d_%H-%M-%S).mp4"
    # setsid keeps ffmpeg running after StumpWM's shell or the menu exits
    setsid ffmpeg -nostdin -hide_banner -loglevel error -y \
        "${args[@]}" "${audio_args[@]}" "${video_args[@]}" "$file" \
        > "$LOG_FILE" 2>&1 < /dev/null &
    echo $! > "$PID_FILE"
    echo "$file" > "$OUT_FILE"

    sleep 0.5
    recording || fail "ffmpeg stopped: $(tail -c 300 "$LOG_FILE")"
    refresh_bar
}

stop() {
    local pid file
    pid=$(cat "$PID_FILE" 2>/dev/null)
    file=$(cat "$OUT_FILE" 2>/dev/null)
    # SIGINT lets ffmpeg write the MP4 index; kill it after 5 seconds
    kill -INT "$pid" 2>/dev/null
    for _ in {1..50}; do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
    done
    kill -KILL "$pid" 2>/dev/null
    rm -f "$PID_FILE" "$OUT_FILE"
    refresh_bar
    notify-send -h string:x-dunst-stack-tag:record "Screen recording saved" "$file"
    echo "$file"
}

case "${1:-}" in
    region | screen)
        if recording; then
            stop
        else
            start "$1" "${2:-none}"
        fi
        ;;
    stop) recording && stop ;;
    status) recording ;;
    indicator)
        recording && echo "%{A1:~/Code/dotfiles/guix/scripts/record stop:}"$'\U000f044a'"%{A}"
        exit 0
        ;;
    *)
        echo "Usage: record region|screen [none|desktop|mic|both] | stop | status | indicator" >&2
        exit 1
        ;;
esac
