#!/usr/bin/env bash
# Lock the screen the way Omarchy's hyprlock looks: the desktop blurred, a ring in
# the theme's accent color and "Enter Password" in the theme font.
# Usage: lock [COMMAND...]          lock, then run COMMAND (e.g. lock loginctl suspend)
#        lock --wait [COMMAND...]   stay running until unlocked (xss-lock needs this)
#
# i3lock-color can only unlock with the PAM entry from screen-locker-service-type
# in guix/system/config.scm, so until that exists this falls back to slock.

THEME_DIR="$HOME/.config/theme/current"

color() {
    # color KEY DEFAULT: RRGGBB from the generated polybar.ini, without the #
    local value
    value=$(sed -n "s/^$1 = #//p" "$THEME_DIR/polybar.ini" 2>/dev/null)
    echo "${value:-$2}"
}

i3lock_args() {
    local bg fg accent red green muted font
    bg=$(color bg 1E1E2E)
    fg=$(color fg CDD6F4)
    accent=$(color blue 89B4FA)
    red=$(color red F38BA8)
    green=$(color green A6E3A1)
    muted=$(color muted 585B70)
    font=$(cat "$THEME_DIR/font" 2>/dev/null)
    font="${font:-JetBrains Mono}"

    LOCK_ARGS=(
        --blur=8
        --indicator --radius=110 --ring-width=6
        --inside-color="${bg}cc" --ring-color="${accent}ff"
        --insidever-color="${bg}cc" --ringver-color="${green}ff"
        --insidewrong-color="${bg}cc" --ringwrong-color="${red}ff"
        --line-uses-inside --separator-color=00000000
        --keyhl-color="${fg}ff" --bshl-color="${muted}ff"
        --verif-color="${fg}ff" --wrong-color="${red}ff" --modif-color="${fg}ff"
        --verif-text="Verifying" --wrong-text="Wrong password" --noinput-text="No input"
        --greeter-text="Enter Password" --greeter-color="${fg}ff"
        --greeter-size=28 --greeter-pos="ix:iy+170"
        --{verif,wrong,greeter}-font="$font"
        --ignore-empty-password --show-failed-attempts
        --pass-media-keys --pass-volume-keys
    )
}

WAIT=
if [[ "$1" == --wait ]]; then
    WAIT=1
    shift
fi

# Already locked
pgrep -x 'i3lock|slock' >/dev/null && exit 0

if [[ -f /etc/pam.d/i3lock ]] && command -v i3lock >/dev/null; then
    i3lock_args
    # Without --wait, i3lock forks once the screen is locked, so COMMAND runs
    # behind the lock; with it, i3lock stays in the foreground until unlock
    i3lock ${WAIT:+--nofork} "${LOCK_ARGS[@]}" || exit 1
    [[ $# -gt 0 ]] && exec "$@"
    exit 0
fi

# slock stays in the foreground until unlock either way
exec slock "$@"
