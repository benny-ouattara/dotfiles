#!/usr/bin/env bash
# Switch the desktop theme.
# Usage: theme-switch            pick a theme with rofi, apply it, reload apps
#        theme-switch THEME      apply THEME and reload apps
#        theme-switch --refresh  regenerate files for the current theme without
#                                reloading apps (StumpWM runs this at startup)
#
# Generated files live in ~/.config/theme/current, outside git. Tracked configs
# keep Catppuccin defaults and include them: kitty/kitty.conf, rofi/colors.rasi,
# polybar/tokyo/config.ini, stumpwm/init.lisp and
# doom/config.el. dunst and starship (STARSHIP_CONFIG in .zshrc) use copies of
# dunst/dunstrc and starship.toml with the colors substituted, so edit the
# tracked files and they carry over.

DOTFILES="$HOME/Code/dotfiles"
THEME_DIR="$HOME/.config/theme/current"
THEMES=(catppuccin tokyonight dracula nord gruvbox everforest onedark)

# --- Color definitions ---
declare -A BG BG_ALT FG SELECTED RED GREEN YELLOW BLUE PURPLE CYAN
declare -A DOOM_THEME
# Terminal color arrays (color0-15)
declare -A C0 C1 C2 C3 C4 C5 C6 C7 C8 C9 C10 C11 C12 C13 C14 C15

