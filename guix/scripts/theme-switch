# --- Generators: each writes one file into $THEME_DIR ---

gen_polybar() {
    cat > "$THEME_DIR/polybar.ini" << EOF
;; Generated by theme-switch (${THEME}); included by polybar/tokyo/config.ini

[color]

alpha = #0000ffff
bg = ${BG[$THEME]}
bg1 = ${BG_ALT[$THEME]}
bg2 = ${BG_ALT[$THEME]}
fg = ${FG[$THEME]}

;; for 50% transparent
trans1 = #80000000
;; 100% transparent
trans2 = #00

;; colors
black = ${BG[$THEME]}
black1 = ${BG[$THEME]}
white = ${FG[$THEME]}
red = ${RED[$THEME]}
green = ${GREEN[$THEME]}
yellow = ${YELLOW[$THEME]}
blue = ${BLUE[$THEME]}
purple = ${PURPLE[$THEME]}
purpledark = ${PURPLE[$THEME]}
cyan = ${CYAN[$THEME]}
teal = ${CYAN[$THEME]}
ocean = ${BLUE[$THEME]}
orange = ${YELLOW[$THEME]}
magenta = ${PURPLE[$THEME]}
gray = ${FG[$THEME]}
bluedark = ${BG_ALT[$THEME]}
cream = ${FG[$THEME]}
indigo = ${BG_ALT[$THEME]}
pink = ${PURPLE[$THEME]}
shade2 = ${BG_ALT[$THEME]}
shade3 = ${BG_ALT[$THEME]}
shade4 = ${BG_ALT[$THEME]}
muted = ${C8[$THEME]}
EOF
}

gen_kitty() {
    {
        cat << EOF
# Generated by theme-switch (${THEME}); included at the end of kitty/kitty.conf
foreground              ${FG[$THEME]}
background              ${BG[$THEME]}
selection_foreground    ${BG[$THEME]}
selection_background    ${FG[$THEME]}
cursor                  ${FG[$THEME]}
cursor_text_color       ${BG[$THEME]}
url_color               ${CYAN[$THEME]}
active_border_color     ${BLUE[$THEME]}
inactive_border_color   ${BG_ALT[$THEME]}
bell_border_color       ${YELLOW[$THEME]}
active_tab_foreground   ${BG[$THEME]}
active_tab_background   ${GREEN[$THEME]}
inactive_tab_foreground ${FG[$THEME]}
inactive_tab_background ${BG_ALT[$THEME]}
tab_bar_background      ${BG[$THEME]}
EOF
        for i in {0..15}; do
            ref="C$i[$THEME]"
            echo "color$i ${!ref}"
        done
    } > "$THEME_DIR/kitty.conf"
}

gen_rofi() {
    cat > "$THEME_DIR/rofi.rasi" << EOF
/* Generated by theme-switch (${THEME}); imported by rofi/colors.rasi */
* {
    background:     ${BG[$THEME]};
    background-alt: ${BG_ALT[$THEME]};
    foreground:     ${FG[$THEME]};
    selected:       ${SELECTED[$THEME]};
    active:         ${GREEN[$THEME]};
    urgent:         ${RED[$THEME]};
}
EOF
}

gen_dunst() {
    # Copy the tracked dunstrc, replacing only the color values
    awk -v bg="${BG[$THEME]}" -v fg="${FG[$THEME]}" \
        -v frame="${BLUE[$THEME]}" -v critical="${RED[$THEME]}" '
        /^\[/ { section = $0 }
        /^[[:space:]]*background[[:space:]]*=/ { sub(/=.*/, "= \"" bg "\"") }
        /^[[:space:]]*foreground[[:space:]]*=/ { sub(/=.*/, "= \"" fg "\"") }
        /^[[:space:]]*frame_color[[:space:]]*=/ {
            sub(/=.*/, "= \"" (section == "[urgency_critical]" ? critical : frame) "\"")
        }
        { print }' "$DOTFILES/dunst/dunstrc" > "$THEME_DIR/dunstrc"
}

gen_starship() {
    # Copy the tracked starship.toml, replacing its trailing [palettes.theme] table
    {
        sed '/^\[palettes\.theme\]/,$d' "$DOTFILES/starship.toml"
        cat << EOF
[palettes.theme]
green = "${GREEN[$THEME]}"
red = "${RED[$THEME]}"
blue = "${BLUE[$THEME]}"
purple = "${PURPLE[$THEME]}"
yellow = "${YELLOW[$THEME]}"
cyan = "${CYAN[$THEME]}"
EOF
    } > "$THEME_DIR/starship.toml"
}

gen_stumpwm() {
    {
        echo ";; Generated by theme-switch (${THEME}); loaded by stumpwm/init.lisp"
        echo "(in-package :stumpwm)"
        echo "(setf"
        for pair in fg:FG bg:BG bg-alt:BG_ALT red:RED green:GREEN yellow:YELLOW blue:BLUE purple:PURPLE cyan:CYAN muted:C8; do
            ref="${pair#*:}[$THEME]"
            echo " *theme-${pair%%:*}* \"${!ref}\""
        done
        echo ")"
    } > "$THEME_DIR/stumpwm.lisp"
}

gen_emacs() {
    # Themes without an Emacs counterpart keep the previous emacs.el
    [[ -z "${DOOM_THEME[$THEME]}" ]] && return
    cat > "$THEME_DIR/emacs.el" << EOF
;;; Generated by theme-switch (${THEME}); loaded by doom/config.el
(setq doom-theme '${DOOM_THEME[$THEME]})
EOF
}

generate() {
    mkdir -p "$THEME_DIR"
    gen_polybar
    gen_kitty
    gen_rofi
    gen_dunst
    gen_starship
    gen_stumpwm
    echo "$THEME" > "$THEME_DIR/name"
}

reload_apps() {
    # Polybar re-reads polybar.ini on restart; start-polybar also refills the groups module
    stumpish start-polybar >/dev/null 2>&1
    stumpish eval "(progn (load \"$THEME_DIR/stumpwm.lisp\") (apply-theme-colors) (polybar-update-groups))" >/dev/null 2>&1
    kill -SIGUSR1 $(pgrep kitty) 2>/dev/null
    dunstctl reload "$THEME_DIR/dunstrc" >/dev/null 2>&1
    if [[ -n "${DOOM_THEME[$THEME]}" ]]; then
        emacsclient -e "(progn (load \"$THEME_DIR/emacs.el\" nil t) (mapc #'disable-theme custom-enabled-themes) (load-theme doom-theme t))" >/dev/null 2>&1
    fi
    # A theme with its own ~/Sync/wallpapers/themes/<theme> folder changes the background
    "$DOTFILES/guix/scripts/wallpaper" themed && "$DOTFILES/guix/scripts/wallpaper" next
}

# --- Main ---
CURRENT=$(cat "$THEME_DIR/name" 2>/dev/null)

case "${1:-}" in
    --refresh)
        THEME="${CURRENT:-catppuccin}"
        ;;
    "")
        row=0
        for i in "${!THEMES[@]}"; do
            [[ "${THEMES[$i]}" == "$CURRENT" ]] && row=$i
        done
        THEME=$(printf '%s\n' "${THEMES[@]}" | rofi -dmenu -p 'Theme' -selected-row "$row" -theme ~/.config/rofi/menu.rasi)
        [[ -z "$THEME" ]] && exit 0
        ;;
    *)
        THEME="$1"
        ;;
esac

if [[ ! " ${THEMES[*]} " =~ " ${THEME} " ]]; then
    echo "Unknown theme: $THEME (available: ${THEMES[*]})" >&2
    notify-send -u critical "Theme" "Unknown theme: $THEME" 2>/dev/null
    exit 1
fi

generate
# emacs.el only changes on an explicit switch, so a first --refresh leaves
# Emacs on the theme doom/config.el picks
[[ "${1:-}" == "--refresh" ]] && exit 0
gen_emacs

reload_apps
notify-send "Theme" "Switched to $THEME" 2>/dev/null
echo "Switched to: $THEME"
