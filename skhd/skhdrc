# emacs and terminal
cmd - return : open -n /Applications/kitty.app
cmd - d :  emacsclient -c -e '(dired "~")'
cmd - e :  emacsclient -c -e '(elfeed)'
cmd + ctrl - m :  emacsclient -c -e '(mu4e)'
cmd - a : emacsclient -c -e '(org-agenda)'

# use ranger in kitty for image support
cmd + ctrl - v : open -n /Applications/kitty.app --args command ranger

cmd - i : open -a /Applications/Emacs.app
cmd - b : open -na "Brave Browser"
cmd - y : emacsclient -c -e '(find-file "~/Sync/org")'
cmd + ctrl - c : ~/.emacs.d/bin/org-capture

# focus window
cmd - j : yabai -m window --focus prev
cmd + ctrl - h : yabai -m window --ratio rel:-0.05
cmd + ctrl - l : yabai -m window --ratio rel:0.05
cmd - k : yabai -m window --focus next
cmd + ctrl - 0x21 : yabai -m window --focus stack.prev # this is [
cmd + ctrl - 0x1E : yabai -m window --focus stack.next # this is ]

# swap instead of warp
cmd + shift - j : yabai -m window --swap west
cmd + shift - k : yabai -m window --swap east

# balance size of windows
cmd - 0 : yabai -m space --balance
cmd - 9 : yabai -m space --balance && yabai -m window --ratio rel:0.2
cmd - 8 : yabai -m space --balance && yabai -m window --ratio rel:-0.2

# fast focus desktop
cmd + ctrl - tab : yabai -m space --focus recent
cmd + ctrl - p : yabai -m space --focus prev
cmd + ctrl - n : yabai -m space --focus next
cmd - 1 : yabai -m space --focus 1
cmd - 2 : yabai -m space --focus 2
cmd - 3 : yabai -m space --focus 3
cmd - 4 : yabai -m space --focus 4
cmd - 5 : yabai -m space --focus 5
cmd - 6 : yabai -m space --focus 6
cmd - 7 : yabai -m space --focus 7

# send window to desktop and follow focus
cmd + shift - tab : yabai -m window --space recent; yabai -m space --focus recent
cmd + shift - p : yabai -m window --space prev; yabai -m space --focus prev
cmd + shift - n : yabai -m window --space next; yabai -m space --focus next
cmd + shift - 1 : yabai -m window --space  1; yabai -m space --focus 1
cmd + shift - 2 : yabai -m window --space  2; yabai -m space --focus 2
cmd + shift - 3 : yabai -m window --space  3; yabai -m space --focus 3
cmd + shift - 4 : yabai -m window --space  4; yabai -m space --focus 4
cmd + shift - 5 : yabai -m window --space  5; yabai -m space --focus 5
cmd + shift - 6 : yabai -m window --space  6; yabai -m space --focus 6
cmd + shift - 7 : yabai -m window --space  7; yabai -m space --focus 7

# set insertion point in focused container
cmd + alt - h : yabai -m window --insert west
cmd + alt - j : yabai -m window --insert south
cmd + alt - k : yabai -m window --insert north
cmd + alt - l : yabai -m window --insert east
cmd + alt - s : yabai -m window --insert stack

# toggle window layout
cmd + ctrl - e : yabai -m space --layout float
cmd + shift - e : yabai -m space --layout bsp

# float layout
cmd + ctrl - space : yabai -m window --toggle zoom-fullscreen; sketchybar --trigger window_focus

# window management
cmd + ctrl - w : yabai -m window --close
cmd - r : yabai -m space --rotate 90
cmd + shift - r : yabai -m space --mirror y-axis

# Enable / Disable gaps in current workspace
cmd - g : yabai -m space --toggle padding; yabai -m space --toggle gap

# quickshade
cmd + shift - d : open "quickshade://toggle"

# sketchybar
cmd + shift - t : ~/.config/sketchybar/theme-cycle.sh
cmd + shift - b : sketchybar --bar hidden=toggle
cmd + shift - u : sketchybar --reload
cmd + shift - s : sketchybar --set calendar drawing=toggle
cmd + shift - c : sketchybar --set cpu.top drawing=toggle; sketchybar --set cpu.percent drawing=toggle; sketchybar --set cpu.sys drawing=toggle; sketchybar --set cpu.user drawing=toggle
