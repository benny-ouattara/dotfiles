# emacs and terminal
cmd - return : open -n /Applications/kitty.app
cmd + ctrl - d :  emacsclient -c -e '(dired "~")'
cmd + ctrl - i :  emacsclient -c -e '(elfeed)'
cmd + ctrl - m :  emacsclient -c -e '(=notmuch)'
cmd + ctrl - a : emacsclient -c -e '(org-agenda)'

# use ranger in kitty for image support
cmd + ctrl - v : open -n /Applications/kitty.app --args command ranger

cmd - i : /usr/local/bin/emacs
cmd - b : open -na "Brave Browser"
cmd + ctrl - y : emacsclient -c -e '(find-file "~/Sync/org")'
cmd + ctrl - c : ~/.emacs.d/bin/org-capture

# focus window
cmd - j : yabai -m window --focus prev
cmd + ctrl - h : yabai -m window --ratio rel:-0.05
cmd + ctrl - l : yabai -m window --ratio rel:0.05
cmd - k : yabai -m window --focus next
cmd + ctrl - 0x21 : yabai -m window --focus stack.prev # this is [
cmd + ctrl - 0x1E : yabai -m window --focus stack.next # this is ]

# swap instead of warp
cmd + ctrl - j : yabai -m window --swap west
cmd + ctrl - k : yabai -m window --swap east

# balance size of windows
cmd - 0 : yabai -m space --balance
cmd - 9 : yabai -m space --balance && yabai -m window --ratio rel:0.2
cmd - 8 : yabai -m space --balance && yabai -m window --ratio rel:-0.2

# fast focus desktop
cmd - 1 : yabai -m space --focus 1
cmd - 2 : yabai -m space --focus 2
cmd - 3 : yabai -m space --focus 3
cmd - 4 : yabai -m space --focus 4
cmd - 5 : yabai -m space --focus 5
cmd - 6 : yabai -m space --focus 6
cmd - 7 : yabai -m space --focus 7

# send window to desktop and follow focus
cmd + ctrl - 1 : yabai -m window --space 1; yabai -m space --focus 1
cmd + ctrl - 2 : yabai -m window --space 2; yabai -m space --focus 2
cmd + ctrl - 3 : yabai -m window --space 3; yabai -m space --focus 3
cmd + ctrl - 4 : yabai -m window --space 4; yabai -m space --focus 4
cmd + ctrl - 5 : yabai -m window --space 5; yabai -m space --focus 5
cmd + ctrl - 6 : yabai -m window --space 6; yabai -m space --focus 6
cmd + ctrl - 7 : yabai -m window --space 7; yabai -m space --focus 7

# toggle window layout
cmd + ctrl - f : yabai -m space --layout float
cmd + ctrl - e : yabai -m space --layout bsp

# float layout
cmd + ctrl - space : yabai -m window --toggle zoom-fullscreen; sketchybar --trigger window_focus

# window management
cmd + ctrl - w : yabai -m window --close
cmd + ctrl - o : yabai -m space --rotate 90
cmd + ctrl - r : yabai -m space --mirror y-axis

# Enable / Disable gaps in current workspace
cmd - g : yabai -m space --toggle padding; yabai -m space --toggle gap

# quickshade
cmd + ctrl - q : open "quickshade://toggle"

# sketchybar
cmd + ctrl - t : ~/.config/sketchybar/theme-cycle.sh
cmd + ctrl - b : sketchybar --bar hidden=toggle
cmd + ctrl - u : sketchybar --reload
cmd + ctrl - s : sketchybar --set calendar drawing=toggle
